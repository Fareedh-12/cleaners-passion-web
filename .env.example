# Native Cleaners Passion enquiry system
# Create a Resend API key and verify cleanerspassion.com before using a domain sender.
RESEND_API_KEY=re_your_api_key
ENQUIRY_FROM_EMAIL=Cleaners Passion <enquiries@cleanerspassion.com>
ENQUIRY_TO_EMAIL=info@cleanerspassion.com

# Optional second delivery/storage channel. This can point to a Google Apps Script,
# Zapier/Make webhook, CRM, or another endpoint that stores the enquiry.
ENQUIRY_WEBHOOK_URL=
